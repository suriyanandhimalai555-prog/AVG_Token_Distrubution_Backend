# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/bnb-distribution

# Server port
PORT=4000

# Absolute path to the bnb-token-distribution project on this machine.
# The backend spawns scripts from this directory, so they naturally pick up
# their own .env (ALCHEMY_RPC_URL, TOKEN_ADDRESS, MULTISENDER_ADDRESS, etc.)
# No need to duplicate those values here.
SCRIPTS_DIR=../../bnb-token-distribution

# Frontend URL for CORS (set to your Vercel URL in production)
FRONTEND_URL=http://localhost:5173

NODE_ENV=development
