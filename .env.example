# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/bnb-distribution?retryWrites=true&w=majority&authSource=admin

# Server port
PORT=4000

# Frontend URL for CORS (set to your Vercel/production URL in prod)
FRONTEND_URL=http://localhost:5173

# Environment
NODE_ENV=development

# Session secret for Express sessions (set a strong random string in real .env)
SESSION_SECRET=change-me-in-production
# Optional: keep as false unless Mongo connectivity is stable
USE_MONGO_SESSION_STORE=false

# Google OAuth credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Optional client URL alias (often same as FRONTEND_URL)
CLIENT_URL=http://localhost:5173

# ─── RPC Endpoints (replace with your own provider keys) ───────────────────────
ALCHEMY_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/your-key
BSC_TESTNET_RPC_URL=https://bnb-testnet.g.alchemy.com/v2/your-key
FALLBACK_RPC_1=https://bsc-dataseed1.binance.org
FALLBACK_RPC_2=https://bsc-dataseed2.binance.org

# ─── Distribution (optional) ───────────────────────────────────────────────────
# BATCH_SIZE = wallets per multisend batch (MultiSender / prepare). Not the worker script's parallelism.
# BATCH_SIZE=10
# PARALLEL_BATCHES = parallel workers in scripts/distribute.ts (1–10). Independent of BATCH_SIZE.
# PARALLEL_BATCHES=5

# ─── Optional opBNB support ────────────────────────────────────────────────────
OPBNB_TOKEN_ADDRESS=
OPBNB_MULTISENDER_ADDRESS=
